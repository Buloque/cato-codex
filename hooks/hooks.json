{
  "hooks": {
    "PostModelRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/hooks/post-model-request.js\"",
            "timeout": 5,
            "statusMessage": "Recording measured token usage"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/hooks/post-tool-use.js\"",
            "timeout": 8,
            "statusMessage": "Observing supported local tool results"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/hooks/post-compact.js\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
